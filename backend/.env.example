DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_PASSWORD=your_password
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres

SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
STATS_SCHEDULER_ENABLED=true

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PARKING_CACHE_TTL_SECONDS=30

# Reservation expiry and observation readiness (10-minute hold is fixed in service).
RESERVATION_SCHEDULER_ENABLED=true
RESERVATION_SWEEP_SECONDS=1
OBSERVATION_MAX_AGE_SECONDS=15
